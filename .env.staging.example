# Copy this file to .env.staging.local and fill in real staging values.
# Never commit .env.staging.local itself (it's gitignored) — this file
# must only ever contain placeholder values.
#
# This is the ONLY env file scripts/start-staging.js loads — it never
# reads the default .env, so a developer's production-pointed local .env
# (a real, already-occurred mixup — see docs/engineering/
# STAGING_ENVIRONMENT_PLAN.md and the 2026-09-12 staging audit) can never
# leak into a staging run. services/serverConfig.js's validateStagingEnv
# refuses to start if SUPABASE_URL isn't exactly the staging project or
# STRIPE_SECRET_KEY isn't a test-mode key — this file's job is just to
# supply values that actually pass that check.

# APP_ENV=staging is what triggers the staging validation/guards in
# server.js and services/twilioProvisioning.js — never set this in
# production.
APP_ENV=staging
NODE_ENV=development

# --- Supabase ---
# The staging project ONLY (ref tigwgmayeuisrxjjykqd, "home-call-guard-staging")
# — never the production project (psbzynxplxfbyrbdidmn, "home-call-guard").
# Project Settings -> API in the Supabase dashboard, staging project.
SUPABASE_URL=https://tigwgmayeuisrxjjykqd.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# --- App ---
APP_URL=http://localhost:3000

# --- Stripe ---
# Test-mode keys ONLY — validateStagingEnv refuses to start otherwise.
# There is no separate staging Stripe account; test mode on the same
# account is the isolation mechanism.
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key
STRIPE_PRICE_ID=price_your-test-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-test-webhook-signing-secret

# --- Twilio ---
# WARNING (2026-09-12 staging audit): there is NO separate staging Twilio
# subaccount in this project — this is the same real account production
# uses. A number provisioned/released while running in staging mode is a
# real number in that real account. The APP_ENV=staging guard in
# services/twilioProvisioning.js's releaseQuarantinedTwilioNumber blocks
# the one real-release call path, but provisioning a NEW number is not
# blocked — use a designated, disposable test number for any test that
# needs one, never a real customer's number.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ADDRESS_SID=
TWILIO_BUNDLE_SID=

# --- OpenAI ---
# Optional — the app fails open around this per-request if unset.
OPENAI_API_KEY=your-openai-api-key
