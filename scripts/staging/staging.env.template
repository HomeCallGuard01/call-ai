# Staging environment TEMPLATE (2026-10-04). Copy OUTSIDE the repo, fill the
# <…> values, never commit the filled copy. scripts/staging/start-staging-server.sh
# refuses to start unless the safety values below hold.
HCG_DEPLOYMENT=staging
NODE_ENV=production                      # guards behave as in production (release doc B-10)
APP_ENV=staging
PORT=3099
APP_URL=https://ferret-augmented-distrust.ngrok-free.dev   # reserved ngrok domain used for Phase A
TRUST_PROXY_HOPS=1                       # ngrok = one proxy hop (verify: req.ip shows the caller, not 127.0.0.1)

# Supabase — STAGING project only
SUPABASE_URL=https://tigwgmayeuisrxjjykqd.supabase.co
SUPABASE_ANON_KEY=<staging anon key>
SUPABASE_SERVICE_ROLE_KEY=<staging service role key>

# Security secrets — generate fresh, ≥32 chars, different from each other and from production
ABUSE_AUDIT_HASH_SECRET=<openssl rand -hex 32>
SAFETY_CALLER_KEY_SECRET=<openssl rand -hex 32>

# Stripe — TEST mode only (the validator refuses a live key in staging)
STRIPE_SECRET_KEY=<sk_test_…>
STRIPE_WEBHOOK_SECRET=<whsec_… of a TEST-mode endpoint pointing at APP_URL/billing/webhook>
STRIPE_PRICE_ID=<price_… TEST-mode £ price>

# RevenueCat — staging webhook auth (RevenueCat's production webhook still points at production)
REVENUECAT_WEBHOOK_AUTHORIZATION=<random ≥16 chars; only if a RevenueCat sandbox webhook is pointed at staging>

# Twilio — shared production account until a staging subaccount exists (B-6).
# NUMBER_PROVISIONING_MODE=fake ⇒ staging can never buy, release or modify a number.
TWILIO_ACCOUNT_SID=<…>
TWILIO_AUTH_TOKEN=<…>
TWILIO_VOICE_API_KEY_SID=<…>
TWILIO_VOICE_API_KEY_SECRET=<…>
TWILIO_VOICE_TWIML_APP_SID=<…>
TWILIO_VOICE_PUSH_CREDENTIAL_SID=<Android FCM credential>
NUMBER_PROVISIONING_MODE=fake
NUMBER_LIFECYCLE_JOBS=disabled
ENABLE_NUMBER_LIFECYCLE_SWEEP_SCHEDULE=false

# OpenAI — bounded by Fortress monitoring caps; set an OpenAI project spend limit (external)
OPENAI_API_KEY=<…>

# Financial containment: D3 reject (leave the degraded-mode variables UNSET)
# Small staging budgets are set in the DB with fc_set_budget_profile after 067.

# Alerts: either leave unset (alerts only in logs) or set — staging alerts are
# labelled "[HCG ALERT STAGING]" and go to the hard-coded support inbox.
Resend_API_Key=

# Everything else OFF in staging unless a test step turns it on deliberately
PROCESS_ROUTE_ENABLED=false
ALLOWANCE_TOPUPS_ENABLED=false
ACCOUNTING_CAPTURE_ENABLED=false
ACCOUNTING_XERO_POSTING_ENABLED=false
OPS_NOTIFY_EMAIL_ENABLED=false
OPS_NOTIFY_PUSH_ENABLED=false
PROVIDER_USAGE_ALERT_TRIP_TRIGGER_SIDS=
TWILIO_VOICE_FALLBACK_URL=
