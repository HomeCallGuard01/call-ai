# Copy to .env and fill in real values for local development.
# EXPO_PUBLIC_-prefixed variables are compiled into the client bundle by
# Expo (not server-side secrets) — these are the same values already
# safe to expose to any client: the Supabase anon key (protected by RLS,
# not by secrecy — same as server.js's own anon client) and the
# backend's public base URL.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://www.homecallguard.co.uk

# RevenueCat public SDK key (iOS) — safe to embed client-side, same
# security model as a Stripe publishable key. From RevenueCat dashboard
# → Project settings → API keys → Apple App Store. iOS-only; Android/web
# never read this.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-public-sdk-key
