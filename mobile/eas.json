{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "screenshots": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "staging-android": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://ferret-augmented-distrust.ngrok-free.dev",
        "EXPO_PUBLIC_SUPABASE_URL": "https://tigwgmayeuisrxjjykqd.supabase.co",
        "HCG_BUILD_TARGET": "staging"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging-ios-testflight": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://ferret-augmented-distrust.ngrok-free.dev",
        "EXPO_PUBLIC_SUPABASE_URL": "https://tigwgmayeuisrxjjykqd.supabase.co",
        "HCG_BUILD_TARGET": "staging"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804235643"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "staging-ios-testflight": {
      "ios": {
        "ascAppId": "6804235643"
      }
    }
  }
}
